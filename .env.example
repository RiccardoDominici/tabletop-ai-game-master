# Copy this file to .env (at the root of the repo) and paste your keys.
# .env is outside git: never commit it. Leave empty whatever you don't use.
# Lookup order: environment variable → this file → fallback file (see docs/guide/installation.md).

# Haiku narrator and image control. Required to play with the real narrator.
# Where: https://console.anthropic.com/settings/keys (paid, pay-per-use: see docs/guide/voice-and-costs.md)
ANTHROPIC_API_KEY=

# drama-3 voice (fish-audio) through OpenRouter. Without it, you play with the local Qwen voice (Mac with Apple chip only).
# Where: https://openrouter.ai/keys (top up your credit: pay-per-use)
OPENROUTER_API_KEY=

# CC0 sounds from Freesound (optional: without it, only the sounds already in the repo or in the cache are used).
# Where: https://freesound.org/apiv2/apply/ (free)
FREESOUND_API_KEY=
